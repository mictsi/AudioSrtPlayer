<Window x:Class="AudioSrtPlayer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Audio + SRT Player" Height="720" Width="980" MinHeight="620" MinWidth="780"
        Background="#0F1115"
        Foreground="#E6E8EE">
    <Window.Resources>
        <SolidColorBrush x:Key="PageBackgroundBrush" Color="#0F1115" />
        <SolidColorBrush x:Key="SurfaceBrush" Color="#181C23" />
        <SolidColorBrush x:Key="Surface2Brush" Color="#1E2430" />
        <SolidColorBrush x:Key="BorderBrushDark" Color="#2E3646" />
        <SolidColorBrush x:Key="PrimaryTextBrush" Color="#E6E8EE" />
        <SolidColorBrush x:Key="MutedTextBrush" Color="#AAB3C5" />
        <SolidColorBrush x:Key="AccentBrush" Color="#4F8CFF" />
        <SolidColorBrush x:Key="AccentBorderBrush" Color="#80A9FF" />

        <Style TargetType="Button">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="#2A3242" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="4,1" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#344058" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#263047" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Root" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Background" Value="#141A24" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushDark}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,6" />
        </Style>

        <Style TargetType="ListBoxItem">
            <Setter Property="Padding" Value="12,10" />
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Foreground" Value="{StaticResource PrimaryTextBrush}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder" Background="#1A2230" BorderBrush="#273247" BorderThickness="1" CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemBorder" Property="Background" Value="{StaticResource AccentBrush}" />
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="{StaticResource AccentBorderBrush}" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="FontWeight" Value="Bold" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ItemBorder" Property="BorderBrush" Value="#4E6DA8" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
            <StackPanel>
                <TextBlock Text="Audio + SRT Sync Player" FontSize="22" FontWeight="SemiBold" Foreground="{StaticResource PrimaryTextBrush}" />
                <TextBlock Text="Load an audio file and subtitle file. The active subtitle is highlighted during playback." Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Background="{StaticResource SurfaceBrush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="12" Padding="14" Margin="0,0,0,10">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Name="OpenAudioButton" Grid.Column="0" Content="Open Audio" Click="OpenAudioButton_Click" ToolTip="Choose an audio file" AutomationProperties.Name="Open audio file button" />
                    <TextBlock Name="AudioPathText" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="No audio file selected." TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}" />
                </Grid>

                <Grid Grid.Row="1" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="130" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Name="OpenSrtButton" Grid.Column="0" Content="Open SRT" Click="OpenSrtButton_Click" ToolTip="Choose an SRT subtitle file" AutomationProperties.Name="Open SRT subtitle file button" />
                    <TextBlock Name="SrtPathText" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Text="No subtitle file selected." TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedTextBrush}" />
                </Grid>

                <Grid Grid.Row="2" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button Name="PlayButton" Grid.Column="0" Content="Play" Width="86" Margin="0,0,8,0" Click="PlayButton_Click" ToolTip="Play audio" AutomationProperties.Name="Play audio" />
                    <Button Name="PauseButton" Grid.Column="1" Content="Pause" Width="86" Margin="0,0,8,0" Click="PauseButton_Click" ToolTip="Pause audio" AutomationProperties.Name="Pause audio" />
                    <Button Name="StopButton" Grid.Column="2" Content="Stop" Width="86" Margin="0,0,14,0" Click="StopButton_Click" ToolTip="Stop audio" AutomationProperties.Name="Stop audio" />
                    <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="Space: play/pause • ←/→: seek" />
                </Grid>

                <Grid Grid.Row="3">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Name="CurrentTimeText" Grid.Column="0" VerticalAlignment="Center" Margin="0,0,8,0" Text="00:00" Foreground="{StaticResource MutedTextBrush}" />
                    <Slider Name="PositionSlider"
                            Grid.Column="1"
                            Minimum="0"
                            Maximum="1"
                            Value="0"
                            SmallChange="1"
                            LargeChange="5"
                            PreviewMouseLeftButtonDown="PositionSlider_PreviewMouseLeftButtonDown"
                            PreviewMouseLeftButtonUp="PositionSlider_PreviewMouseLeftButtonUp"
                            ToolTip="Playback position"
                            AutomationProperties.Name="Playback position slider" />
                    <TextBlock Name="DurationText" Grid.Column="2" VerticalAlignment="Center" Margin="8,0,0,0" Text="00:00" Foreground="{StaticResource MutedTextBrush}" />
                </Grid>
            </Grid>
        </Border>

        <Border Grid.Row="2" Background="{StaticResource Surface2Brush}" BorderBrush="{StaticResource BorderBrushDark}" BorderThickness="1" CornerRadius="12" Padding="12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <WrapPanel Grid.Row="0" VerticalAlignment="Center" Margin="0,0,0,8">
                    <Label Content="Search subtitles:" Target="{Binding ElementName=SearchTextBox}" VerticalAlignment="Center" Foreground="{StaticResource PrimaryTextBrush}" />
                    <TextBox Name="SearchTextBox"
                             Width="300"
                             Margin="8,0,8,0"
                             VerticalAlignment="Center"
                             KeyDown="SearchTextBox_KeyDown"
                             TextChanged="SearchTextBox_TextChanged"
                             ToolTip="Type text and press Enter to jump to next match"
                             AutomationProperties.Name="Search subtitles text" />
                    <Button Name="SearchPreviousButton" Content="Previous" Width="94" Margin="0,0,8,0" Click="SearchPreviousButton_Click" AutomationProperties.Name="Find previous subtitle match" />
                    <Button Name="SearchNextButton" Content="Next" Width="94" Margin="0,0,8,0" Click="SearchNextButton_Click" AutomationProperties.Name="Find next subtitle match" />
                    <TextBlock Name="SearchStatusText" VerticalAlignment="Center" Foreground="{StaticResource MutedTextBrush}" Text="No active search." />
                </WrapPanel>

                <TextBlock Grid.Row="1" Name="CurrentSubtitleStatusText" Margin="0,0,0,8" Text="Current subtitle: none" TextWrapping="Wrap" Foreground="{StaticResource PrimaryTextBrush}" FontWeight="SemiBold" />

                <ListBox Grid.Row="2"
                         Name="SubtitleList"
                         ItemsSource="{Binding Subtitles}"
                         FontSize="19"
                         Background="#0F141D"
                         BorderBrush="#2A3242"
                         BorderThickness="1"
                         Padding="10"
                         AutomationProperties.Name="Subtitle lines">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Border>

        <MediaElement Name="AudioElement"
                      LoadedBehavior="Manual"
                      UnloadedBehavior="Manual"
                      Visibility="Collapsed"
                      MediaOpened="AudioElement_MediaOpened"
                      MediaEnded="AudioElement_MediaEnded"
                      MediaFailed="AudioElement_MediaFailed" />
    </Grid>
</Window>
